<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{% if title %}{{ title }} — {% endif %}{{ site.name }}</title>
<meta name="description" content="{{ description or site.bio }}">

<!-- Open Graph / link-preview metadata. Per-page title & description above already
     feed this, so sharing a specific case study or recipe link shows its own preview
     instead of a generic homepage one. -->
<meta property="og:title" content="{% if title %}{{ title }} — {% endif %}{{ site.name }}">
<meta property="og:description" content="{{ description or site.bio }}">
<meta property="og:type" content="website">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,400..500&family=IBM+Plex+Mono:wght@400;500&family=Source+Serif+4:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ '/assets/css/style.css' | url }}">
<link rel="icon" href="{{ '/assets/images/favicon.ico' | url }}">
</head>
<body class="{{ section }}">

<header>
  <nav class="wrap">
    <div class="brand">
      <div class="name">{{ site.name | upper }}</div>
      <a class="about-link {% if section == 'about' %}active{% endif %}" href="{{ '/about/' | url }}">ABOUT</a>
    </div>
    <div class="toggle">
      <a href="{{ '/' | url }}" class="{% if section == 'professional' %}active{% endif %}">
        PROFESSIONAL
        <div class="preview-pop"><b>Data science, measured.</b>Case studies, models, and the numbers behind them.</div>
      </a>
      <a href="{{ '/personal/' | url }}" class="{% if section == 'personal' %}active{% endif %}">
        PERSONAL
        <div class="preview-pop"><b>Recipes, tested.</b>Dishes I've cooked enough times to trust.</div>
      </a>
    </div>
  </nav>
</header>

<main class="wrap">
  {{ content | safe }}
</main>

<footer class="wrap">
  © {{ "now" | year }} {{ site.name }}
</footer>

<script src="{{ '/assets/js/main.js' | url }}"></script>
</body>
</html>
