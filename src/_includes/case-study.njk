---
layout: base.njk
---
<div class="detail-header">
  <a class="back-link" href="{{ '/' | url }}">← BACK TO CASE STUDIES</a>
  <div class="eyebrow">{{ year }}</div>
  <h1>{{ title }}</h1>
</div>

{% if image %}
<img src="{{ image | url }}" alt="{{ title }}" class="header-image">
{% endif %}

<div class="story">
  {{ content | safe }}
</div>

{% if stats and stats.length %}
<div class="meta-strip">
  {% for s in stats %}
  <div><span>{{ s.label | upper }}</span><b>{{ s.value }}</b></div>
  {% endfor %}
</div>
{% endif %}

<div class="tags">
  {% for t in stack %}<span class="tag">{{ t }}</span>{% endfor %}
</div>
<div class="topics">TOPICS: {{ topics }}</div>

{% if attachments and attachments.length %}
<div class="section-head" style="margin-top:44px;">
  <h2 style="font-size:18px;">Appendix</h2>
</div>
{% for att in attachments %}
{% set ext = att.file | fileExt %}
<div class="section-head" style="margin-top:24px; margin-bottom:12px;">
  <h3 style="font-family:var(--serif); font-weight:500; font-size:16px; margin:0;">{{ att.title }}</h3>
  <a class="read" href="{{ att.file | url }}" target="_blank" rel="noopener">OPEN FULL ↗</a>
</div>

{% if ext == 'pdf' %}
<div class="resume-preview" id="preview-att{{ loop.index }}">
  <iframe src="{{ att.file | url }}#toolbar=0&navpanes=0&view=FitH" title="{{ att.title }}"></iframe>
  <div class="resume-fade"></div>
</div>
<button class="expand-btn" id="expand-att{{ loop.index }}" onclick="toggleFilePreview('att{{ loop.index }}')">Show full preview ↓</button>

{% elif ext in ['pptx','ppt','docx','doc','xlsx','xls'] %}
<div class="resume-preview" id="preview-att{{ loop.index }}">
  <iframe src="https://view.officeapps.live.com/op/embed.aspx?src={{ (site.url + (att.file | url)) | urlencode }}" title="{{ att.title }}"></iframe>
  <div class="resume-fade"></div>
</div>
<button class="expand-btn" id="expand-att{{ loop.index }}" onclick="toggleFilePreview('att{{ loop.index }}')">Show full preview ↓</button>
<p style="font-family:var(--mono); font-size:10.5px; opacity:.5; margin-top:8px;">
  Office documents only preview once the site is live — this stays blank on localhost.
</p>

{% else %}
<p style="font-family:var(--mono); font-size:12px; opacity:.6;">
  No inline preview available for .{{ ext }} files — use "Open full" above.
</p>
{% endif %}
{% endfor %}
{% endif %}

<p style="font-family:var(--mono); font-size:11px; opacity:.5; margin-top:32px;">Published {{ page.date | readableDate }}</p>

{% set others = collections.casestudy | without(page.url) | limit(3) %}
{% if others.length %}
<div class="section-head" style="margin-top:24px;">
  <h2 style="font-size:18px;">More case studies</h2>
</div>
<div class="more-grid">
  {% for item in others %}
  <a class="more-card" href="{{ item.url | url }}">
    <b>{{ item.data.title }}</b>
    <span>{{ item.data.year }}</span>
  </a>
  {% endfor %}
</div>
{% endif %}
